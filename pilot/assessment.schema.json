{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ayliea:pilot:assessment:2",
  "title": "Draft AI Assurance pilot assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "manifest_sha256", "as_of", "profile", "evidence", "observations"],
  "properties": {
    "assessment_id": {"$ref": "#/$defs/text"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "as_of": {"type": "string", "format": "date"},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "control_ids", "scope_kind"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "control_ids": {"$ref": "#/$defs/ids"},
        "scope_kind": {"enum": ["full-draft-baseline", "synthetic-subset"]}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "mappings": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "alternatives", "evidence_delta_ids"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^synthetic:.+"},
        "alternatives": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1}},
        "evidence_delta_ids": {"$ref": "#/$defs/ids"}
      }
    }},
    "maturity_narratives": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "origin", "source", "provenance", "collected_at", "valid_until", "confidence", "coverage", "sufficient", "available"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"}, "provenance": {"$ref": "#/$defs/text"},
        "origin": {"enum": ["direct", "inherited", "mixed"]},
        "collected_at": {"type": "string", "format": "date"}, "valid_until": {"type": "string", "format": "date"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "coverage": {"$ref": "#/$defs/ids"}, "sufficient": {"type": "boolean"}, "available": {"type": "boolean"},
        "inheritance": {
          "type": "object", "additionalProperties": false,
          "required": ["scope_verified", "period_verified", "responsibility_verified"],
          "properties": {"scope_verified": {"type": "boolean"}, "period_verified": {"type": "boolean"}, "responsibility_verified": {"type": "boolean"}}
        }
      },
      "allOf": [{"if": {"properties": {"origin": {"enum": ["inherited", "mixed"]}}}, "then": {"required": ["inheritance"]}}]
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "applicability", "state", "evidence_ids", "test_activity"],
      "properties": {
        "criterion_id": {"$ref": "#/$defs/text"},
        "applicability": {"enum": ["applicable", "not-applicable", "unresolved"]},
        "state": {"enum": ["pass", "fail", "unknown", "not-tested"]},
        "test_activity": {"enum": ["performed", "attempted", "not-performed", "undetermined"]},
        "evidence_ids": {"$ref": "#/$defs/ids"}, "reason": {"type": "string"},
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["procedure_id", "scope", "system_version", "population_size", "sample_ids", "selection_method", "period_start", "period_end", "performed_at", "assessor", "observations", "limitations"],
          "properties": {
            "procedure_id": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "system_version": {"$ref": "#/$defs/text"},
            "population_size": {"type": "integer", "minimum": 1},
            "sample_ids": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1},
            "selection_method": {"$ref": "#/$defs/text"}, "assessor": {"$ref": "#/$defs/text"}, "observations": {"$ref": "#/$defs/text"},
            "period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"}, "performed_at": {"type": "string", "format": "date"},
            "limitations": {"type": "string"}
          }
        },
        "na": {
          "type": "object", "additionalProperties": false,
          "required": ["rationale", "owner_approval", "assessor_approval"],
          "properties": {"rationale": {"$ref": "#/$defs/text"}, "owner_approval": {"$ref": "#/$defs/text"}, "assessor_approval": {"$ref": "#/$defs/text"}}
        }
      },
      "allOf": [{"if": {"properties": {"applicability": {"const": "not-applicable"}}}, "then": {"required": ["na"]}, "else": {"not": {"required": ["na"]}}}]
    }
  }
}
